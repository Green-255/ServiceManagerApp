@model ServiceManagerApp.Models.ViewModels.Workers.WorkerEditViewModel
@{
}

<h2> Edit worker @Model.ReferenceNumber</h2>

<form asp-action="Edit" , method="post">
    <label asp-for="Name"></label>
    <input asp-for="Name"
           type="text" />

    <label asp-for="PhoneNumber"></label>
    <input asp-for="PhoneNumber"
           type="tel" />

    <label asp-for="Email"></label>
    <input asp-for="Email"
           type="email" />

    <label asp-for="DepartmentId">Department</label>
    <select asp-for="DepartmentId"
            asp-items="Model.Departments"
            class="form-select">
        <option value="">-- No department --</option>
    </select>

    <label asp-for="JobRoleId">Job role</label>
    <select asp-for="JobRoleId"
            asp-items="Model.JobRoles"
            class="form-select">
        <option value="">-- No department --</option>
    </select>>

    <label asp-for="SkillLevel"></label>
    <input asp-for="SkillLevel" />

    <button type="submit">Save</button>
</form>
