@model ServiceManagerApp.Models.ViewModels.Workers.WorkerViewModel

<h3>
    Worker <strong>@Model.ReferenceNumber</strong>
</h3>

<p>@Model.Name | @Model.Email | @Model.PhoneNumber</p>

@{
    string role = Model.JobRoleName == null ? string.Empty : Model.JobRoleName;
    string department = Model.DepartmentName == null ? string.Empty : "Works at " + Model.DepartmentName;

    <p>@role @department</p>
}
<p>Skill level: @Model.SkillLevel</p>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
    Edit worker's information
</a>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-outline-danger">
        Delete worker
    </button>
</form>

<a asp-action="Index" class="btn btn-outline-secondary">
    Back
</a>