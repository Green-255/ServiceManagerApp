@model IReadOnlyList<ServiceManagerApp.Models.ViewModels.Workers.WorkerIndexViewModel>

@{
    ViewData["Title"] = "Workers";
    var workers = Model.ToList();

    string ReadableLabel(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value.Replace("_", " "), @"(?<=[a-z0-9])(?=[A-Z])", " ");

    string AvailabilityBadgeClass(string status) => status switch
    {
        "Available" => "bg-success bg-opacity-10 text-success",
        "Busy" or "Working" or "InProgress" => "bg-warning bg-opacity-25 text-dark",
        "Unavailable" or "NotAvailable" or "OnLeave" or "Offline" => "bg-secondary bg-opacity-10 text-secondary",
        "Inactive" or "Suspended" => "bg-danger bg-opacity-10 text-danger",
        "OnCall" => "bg-warning bg-opacity-10 text-dark",
        _ => "bg-secondary bg-opacity-10 text-secondary"
    };

    var availabilityOptions = workers.Select(w => w.AvailabilityStatus.ToString())
                                     .Distinct()
                                     .OrderBy(s => s)
                                     .ToList();
}

<div class="container py-4" style="max-width: 1120px;">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Workers</h1>
            <p class="text-muted mb-0">Find team members and manage their roles, skills, and availability.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary align-self-start align-self-sm-auto">
            + Add worker
        </a>
    </div>

    <section aria-labelledby="workerDirectoryHeading">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white px-4 py-3">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0" id="workerDirectoryHeading">Worker directory</h2>
                            <span class="badge rounded-pill bg-secondary">@workers.Count</span>
                        </div>
                        <p class="small text-muted mb-0">Browse the workforce and open a profile to see more information.</p>
                    </div>
                    @if (workers.Count > 0)
                    {
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <div>
                                <label for="workerSearch" class="visually-hidden">Search workers</label>
                                <input id="workerSearch" type="search" class="form-control form-control-sm"
                                       placeholder="Search name, reference, role..." autocomplete="off"
                                       aria-controls="workersTable" />
                            </div>
                            <div>
                                <label for="workerAvailabilityFilter" class="visually-hidden">Filter by availability</label>
                                <select id="workerAvailabilityFilter" class="form-select form-select-sm" aria-controls="workersTable">
                                    <option value="">All availability</option>
                                    @foreach (var status in availabilityOptions)
                                    {
                                        <option value="@status">@ReadableLabel(status)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (workers.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <h3 class="h6 mb-2">No workers yet</h3>
                    <p class="text-muted mb-3">Add your first worker to start building your team directory.</p>
                    <a asp-action="Create" class="btn btn-outline-primary btn-sm">Add a worker</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="workersTable">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4 py-3">Worker</th>
                                <th scope="col" class="py-3">Reference number</th>
                                <th scope="col" class="py-3">Job role</th>
                                <th scope="col" class="py-3">Skill level</th>
                                <th scope="col" class="py-3">Availability</th>
                                <th scope="col" class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in workers)
                            {
                                var status = worker.AvailabilityStatus.ToString();
                                var role = string.IsNullOrWhiteSpace(worker.JobRoleName)
                                    ? "Not assigned"
                                    : worker.JobRoleName;
                                var searchText = $"{worker.Name} {worker.ReferenceNumber} {role} {ReadableLabel(worker.SkillLevel.ToString())} {ReadableLabel(status)}";

                                <tr data-search="@searchText" data-availability="@status">
                                    <th scope="row" class="ps-4 py-3 fw-semibold">
                                        <a asp-action="Details" asp-route-id="@worker.Id"
                                           class="text-decoration-none text-body text-break">@worker.Name</a>
                                    </th>
                                    <td class="py-3 text-nowrap">
                                        <a asp-action="Details" asp-route-id="@worker.Id" class="text-decoration-none">@worker.ReferenceNumber</a>
                                    </td>
                                    <td class="py-3">
                                        @if (string.IsNullOrWhiteSpace(worker.JobRoleName))
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                        else
                                        {
                                            @worker.JobRoleName
                                        }
                                    </td>
                                    <td class="py-3">@ReadableLabel(worker.SkillLevel.ToString())</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill fw-semibold @AvailabilityBadgeClass(status)">
                                            @ReadableLabel(status)
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a asp-action="Details" asp-route-id="@worker.Id"
                                               class="btn btn-sm btn-outline-primary">Details</a>
                                            <a asp-action="Edit" asp-route-id="@worker.Id"
                                               class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="noWorkerMatches" class="d-none text-center text-muted p-4" role="status">
                    No workers match your search or filter.
                </div>
                <div class="card-footer bg-white px-4 py-2">
                    <span class="small text-muted" id="workerListCount" aria-live="polite">@workers.Count workers shown</span>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const search = document.getElementById('workerSearch');
            const availability = document.getElementById('workerAvailabilityFilter');
            const rows = document.querySelectorAll('#workersTable tbody tr[data-search]');
            const noMatches = document.getElementById('noWorkerMatches');
            const count = document.getElementById('workerListCount');

            if (!search || !availability) return;

            function applyFilters() {
                const query = search.value.trim().toLocaleLowerCase();
                const selectedAvailability = availability.value;
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const text = (row.dataset.search || '').toLocaleLowerCase();
                    const matchesSearch = text.includes(query);
                    const matchesAvailability = !selectedAvailability || row.dataset.availability === selectedAvailability;
                    const show = matchesSearch && matchesAvailability;
                    row.classList.toggle('d-none', !show);
                    if (show) visibleCount++;
                });

                noMatches?.classList.toggle('d-none', visibleCount !== 0);
                if (count) count.textContent = `${visibleCount} of ${rows.length} workers shown`;
            }

            search.addEventListener('input', applyFilters);
            availability.addEventListener('change', applyFilters);
        });
    </script>
}
