@model IReadOnlyList<ServiceManagerApp.Models.Entities.JobRole>
@{
    ViewData["Title"] = "Job roles";
    var roles = Model.OrderBy(r => r.Name).ToList();
    var departmentNames = roles.Where(r => r.Department != null)
                               .Select(r => r.Department!.Name)
                               .Distinct()
                               .OrderBy(n => n)
                               .ToList();
    var hasUnassignedRoles = roles.Any(r => r.Department == null);
}

<div class="container py-4" style="max-width: 1120px;">
    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-1">Job roles</h1>
            <p class="text-muted mb-0">Organize positions, link them to departments, and review assigned workers.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary align-self-start align-self-sm-auto">+ Add job role</a>
    </div>

    <section class="card border-0 shadow-sm" aria-labelledby="jobRoleDirectoryHeading">
        <div class="card-header bg-white px-3 px-md-4 py-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 id="jobRoleDirectoryHeading" class="h5 fw-semibold mb-0">Role directory</h2>
                        <span class="badge bg-secondary">@roles.Count</span>
                    </div>
                    <p class="small text-muted mb-0">Search roles or filter by their assigned department.</p>
                </div>
                @if (roles.Count > 0)
                {
                    <div class="d-flex flex-column flex-sm-row gap-2">
                        <div>
                            <label for="jobRoleSearch" class="visually-hidden">Search job roles</label>
                            <input id="jobRoleSearch" type="search" class="form-control form-control-sm"
                                   placeholder="Search roles..." autocomplete="off" aria-controls="jobRolesTable" />
                        </div>
                        <div>
                            <label for="jobRoleDepartmentFilter" class="visually-hidden">Filter by department</label>
                            <select id="jobRoleDepartmentFilter" class="form-select form-select-sm"
                                    aria-controls="jobRolesTable">
                                <option value="">All departments</option>
                                @foreach (var departmentName in departmentNames)
                                {
                                    <option value="@departmentName">@departmentName</option>
                                }
                                @if (hasUnassignedRoles)
                                {
                                    <option value="__unassigned__">Not assigned</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (roles.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h3 class="h6 fw-semibold mb-2">No job roles yet</h3>
                <p class="text-muted mb-3">Create your first role to start organizing positions and employees.</p>
                <a asp-action="Create" class="btn btn-outline-primary btn-sm">Create job role</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="jobRolesTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3 ps-md-4 py-3">Job role</th>
                            <th scope="col" class="py-3">Description</th>
                            <th scope="col" class="py-3">Department</th>
                            <th scope="col" class="py-3 text-center">Workers</th>
                            <th scope="col" class="text-end pe-3 pe-md-4 py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in roles)
                        {
                            var departmentName = role.Department?.Name ?? string.Empty;
                            var searchText = $"{role.Name} {role.Description} {departmentName}";
                            var workerCount = role.Workers?.Count ?? 0;
                            <tr data-role-row data-search="@searchText" data-department="@departmentName">
                                <th scope="row" class="ps-3 ps-md-4 py-3 fw-semibold">
                                    <a asp-action="Details" asp-route-id="@role.Id"
                                       class="text-decoration-none text-body">@role.Name</a>
                                </th>
                                <td class="py-3 text-muted">
                                    @if (string.IsNullOrWhiteSpace(role.Description))
                                    {
                                        <span class="fst-italic">No description</span>
                                    }
                                    else
                                    {
                                        <div class="text-truncate" style="max-width: 300px;" title="@role.Description">
                                            @role.Description
                                        </div>
                                    }
                                </td>
                                <td class="py-3">
                                    @if (role.Department == null)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">Not assigned</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Department" asp-action="Details" asp-route-id="@role.Department.Id"
                                           class="text-decoration-none">@departmentName</a>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge bg-light text-secondary border">@workerCount</span>
                                </td>
                                <td class="text-end pe-3 pe-md-4 py-3 text-nowrap">
                                    <a asp-action="Details" asp-route-id="@role.Id"
                                       class="btn btn-sm btn-outline-primary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@role.Id"
                                       class="btn btn-sm btn-outline-secondary ms-1">Edit</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="jobRoleFilterEmpty" class="card-body text-center py-5 border-top d-none" role="status">
                <h3 class="h6 fw-semibold mb-2">No matching job roles</h3>
                <p class="small text-muted mb-0">Try another search term or department filter.</p>
            </div>
            <div class="card-footer bg-white px-3 px-md-4 py-3">
                <span id="jobRoleResultCount" class="small text-muted" aria-live="polite">Showing @roles.Count of @roles.Count roles</span>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('jobRoleSearch');
            const department = document.getElementById('jobRoleDepartmentFilter');
            if (!search || !department) return;

            const rows = [...document.querySelectorAll('[data-role-row]')];
            const counter = document.getElementById('jobRoleResultCount');
            const empty = document.getElementById('jobRoleFilterEmpty');

            const update = () => {
                const query = search.value.trim().toLocaleLowerCase();
                const selectedDepartment = department.value;
                let visibleCount = 0;

                for (const row of rows) {
                    const rowDepartment = row.dataset.department || '';
                    const matchesSearch = (row.dataset.search || '').toLocaleLowerCase().includes(query);
                    const matchesDepartment = !selectedDepartment ||
                        (selectedDepartment === '__unassigned__' ? rowDepartment === '' : rowDepartment === selectedDepartment);
                    const visible = matchesSearch && matchesDepartment;
                    row.classList.toggle('d-none', !visible);
                    if (visible) visibleCount++;
                }

                counter.textContent = `Showing ${visibleCount} of ${rows.length} roles`;
                empty.classList.toggle('d-none', visibleCount !== 0);
            };

            search.addEventListener('input', update);
            department.addEventListener('change', update);
        })();
    </script>
}
