@model IReadOnlyList<ServiceManagerApp.Models.Entities.JobRole>
@{
    ViewData["Title"] = "Jobe Roles";
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            Job Roles
        </h1>
        <p class="text-muted mb-0">
            Manage job roles.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add a role
    </a>
</div>


<!-- Job Role list -->
@if (!Model.Any())
{
    <div class="border rounded p-4 text-center">
        <h2 class="h5">No job roles found</h2>
        <p class="text-muted">
            Create your first job role to get started.
        </p>
        
        <a asp-action="Create" class="btn btn-primary">
            Add a role
        </a>
    </div>
}
else{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Description</th>
                    <th scope="col"></th>
                    <th scope="col">Department</th>
                    <th scope="col"></th>
                </tr>
            </thead>

            <tbody>
                @foreach(var role in Model)
                {
                    string departmentName = @role.Department != null ? role.Department.Name : "-";
                    <tr>
                        <td class="fw-semibold">@role.Name</td>
                        <td>@role.Description</td>
                        <td>@role.Workers.Count</td>
                        <td>@departmentName</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-outline-primary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
