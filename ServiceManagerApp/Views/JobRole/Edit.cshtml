@model ServiceManagerApp.Models.ViewModels.JobRoles.JobRoleCreateEditViewModel
@{
    // ViewData["Title"] = "Create job role";
}
@{
    <h3> Edit <strong>@Model.Name</strong> job role</h3>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />
        
        <label asp-for="Name">Name:</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>

        
        <label asp-for="Description">Descriptiom:</label>
        <input asp-for="Description" />
        <span asp-validation-for="Description" class="text-danger"></span>


        <label asp-for="DepartmentId">Department</label>
        <select asp-for="DepartmentId"
                asp-items="Model.Departments"
                class="form-select">
            <option value="">-- No department --</option>
        </select>

        @* <label asp-for="Workers">Workers</label>
        <input asp-for="Workers" /> *@

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
            Cancel
        </a>
    </form>
}

