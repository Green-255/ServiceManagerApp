@model ServiceManagerApp.Models.ViewModels.JobRoles.JobRoleCreateEditViewModel
@{
    // ViewData["Title"] = "Create job role";
}
@{
    <h3> Edit <strong>@Model.Name</strong> job role</h3>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        
        <label asp-for="Name">Name:</label>
        <input asp-for="Name" />

        <label asp-for="Description">Descriptiom:</label>
        <input asp-for="Description" />

        <label asp-for="DepartmentId">Department</label>
        <select asp-for="DepartmentId"
                asp-items="Model.Departments"
                class="form-select">
            <option value="">-- No department --</option>
        </select>

        @* <label asp-for="Workers">Workers</label>
        <input asp-for="Workers" /> *@

        <button type="submit">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
    </form>
}

