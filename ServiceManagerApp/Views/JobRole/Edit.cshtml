@model ServiceManagerApp.Models.ViewModels.JobRoles.JobRoleCreateEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">

        <!-- Page Header -->
        <div class="mb-4 border-bottom">
            <h1 class="h3">
                Edit <strong>@Model.Name</strong>.
            </h1>
            <p class="text-muted">
                Update @Model.Name job role.
            </p>
        </div>

        
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Name -->
            <div class="mb-4 col-md-4">
                <label asp-for="Name" class="form-label text-muted mb-1">Name:</label>
                <input asp-for="Name" class="form-control "
                    style="width:100%; max-width:300px"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label asp-for="Description" class="form-label text-muted mb-1">Description:</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Department -->
            <div class="mb-4">
                <label asp-for="DepartmentId" class="text-muted">Department</label>
                <select asp-for="DepartmentId"
                        asp-items="Model.Departments"
                        class="form-select">
                    <option value="">-- No department --</option>
                </select>
            </div>

                @* <label asp-for="Workers">Workers</label>
                <input asp-for="Workers" /> *@

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>

        </form>
    </div>
</div>

