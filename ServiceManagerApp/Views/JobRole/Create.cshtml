@model ServiceManagerApp.Models.ViewModels.JobRoles.JobRoleCreateEditViewModel
<h2> Add new job role</h2>

<form asp-action="Create" , method="post">
    <label asp-for="Name"></label>
    <input asp-for="Name"
           type="text" />

    <label asp-for="Description"></label>
    <input asp-for="Description"
           type="text" />

    <label asp-for="DepartmentId"></label>
    <select asp-for="DepartmentId"
        asp-items="Model.Departments"
        class="form-select">
        <option value="">-- No department --</option>
    </select>
    @* <label asp-for="Department"></label>
    <input asp-for="Department" />

    <label asp-for="Workers"></label>
    <input asp-for="Workers" /> *@

    <button type="submit">Add</button>
</form>