@model ServiceManagerApp.Models.Entities.JobRole
@* @using ServiceManagerApp.Models.Entities *@

@{
    ViewData["Title"] = Model.Name;
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">
            &larr; Back to Job roles
        </a>
        
        <h1 class="h3 mt-3 mb-0">
            @Model.Name
        </h1>

    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        Edit job role
    </a>
</div>


<!-- Job role information -->
<section class="mb-4">
    <h2 class="h5">Description:</h5>

    <p class="text-muted">
        @if(Model.Department == null)
        {
            <text>This job role has not been assigned to any department.</text>
        }
        else
        {
            <text>Department: <strong> @Model.Department.Name </strong></text>
        }
       
    </p>
    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(Model.Description)
            ? "No description provided." : Model.Description)
    </p>
</section>


<!-- Assigned job role workers -->
<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Workers</h2>

        <span class="text-muted">
            @Model.Workers.Count workers
        </span>
    </div>
    <div>
        @if (!Model.Workers.Any())
        {
            <div class="border rounded p-4 text-center">
                <p class="text-muted mb-0">
                    No workers assigned to this job role.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead  class="table-light">
                        <th>Name</th>
                        <th></th>
                    </thead>
                    <tbody>
                        @foreach (var worker in Model.Workers)
                        {
                            <tr>
                                <td scope="col">worker.Name</td>
                                <td scope="col">worker.Workers.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</section>

    
<!-- Destructiove actions -->
<div class="d-flex justify-content-end mt-4">
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
        onsubmit="return confirm('Delete this job role?')">

        <button type="submit" class="btn btn-outline-danger">
            Delete department
        </button>
    </form>
</div>
