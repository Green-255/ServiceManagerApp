@using ServiceManagerApp.Models.Enums
@model ServiceManagerApp.Models.ViewModels.ServiceRequests.ServiceRequestEditViewModel
@{
}

<h3> Edit @Model.ReferenceNumber request. </h3>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <label asp-for="ServiceRequestType"></label>
    <select asp-for="ServiceRequestType"
        asp-items="Html.GetEnumSelectList<ServiceRequestType>()"
        class="form-select">
    </select>

    <label asp-for="Title"> Title </label>
    <input asp-for="Title"
        class="ServiceRequest-Title"/>

    <label asp-for="Description"> Description </label>
    <input asp-for="Description" 
        class="ServiceRequest-Description"/>

    <label asp-for="RequestedDueUtc"> Due Date </label>
    <input asp-for="RequestedDueUtc"
        class="ServiceRequest-RequestedDueUtc" type="datetime-local"/>

    <button type="submit">Save</button>
</form>


