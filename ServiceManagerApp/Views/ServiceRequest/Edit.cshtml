@using ServiceManagerApp.Models.Enums
@model ServiceManagerApp.Models.ViewModels.ServiceRequests.ServiceRequestEditViewModel
@{
}

<h3> Edit @Model.ReferenceNumber request. </h3>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReferenceNumber" />

    <label asp-for="ServiceRequestType"></label>
    <select asp-for="ServiceRequestType"
        asp-items="Html.GetEnumSelectList<ServiceRequestType>()"
        class="form-select">
    </select>

    <label asp-for="Title"> Title </label>
    <input asp-for="Title" class="ServiceRequest-Title"/>
    <span asp-validation-for="Title" class="text-danger"></span>

    <label asp-for="Description"> Description </label>
    <input asp-for="Description" class="ServiceRequest-Description"/>
    <span asp-validation-for="Description" class="text-danger"></span>


    <label asp-for="RequestedDueUtc"> Due Date </label>
    <input asp-for="RequestedDueUtc" class="ServiceRequest-RequestedDueUtc"/>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>


