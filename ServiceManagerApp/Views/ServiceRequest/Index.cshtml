@model IReadOnlyList<ServiceRequestIndexViewModel>

<h1> Service Requests </h1>
<a asp-action="Create"> New request </a>
<table>
    @{
        if (!Model.Any())
        {
            <p>No service requests</p>
        }

        else
        {
            <thead>
            
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Title</td>
                        <td>@request.ServiceRequestType</td>
                        <td>@request.Description</td>
                        <td>@request.Status</td>
                        @if(request.RequestedDueUtc != null)
                        {
                            <td>@request.RequestedDueUtc</td>
                        }
                        <td>@request.ReferenceNumber</td>
                    </tr>
                }
            </tbody>
            
        }
    }
</table>

