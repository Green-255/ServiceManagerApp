@model ServiceManagerApp.Models.ViewModels.ServiceRequests.ServiceRequestDetailsViewModel

<h3> @Model.ServiceRequestType <strong> @Model.Title </strong> </h3>

<p>
    <strong>Status:</strong> @Model.RequestStatus
</p>
<h3> <strong>Description:</strong> </h3>
<p>
    @Model.Description
</p>
    <p>
        <strong>Due to:</strong> @Model.RequestedDueUtc
    </p>
    <p>
        <weak>Request created:</weak> @Model.CreatedAtUtc
    </p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit">Delete</button>
</form>


