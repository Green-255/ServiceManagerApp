@model ServiceManagerApp.Models.ViewModels.Departments.DepartmentCreateEditViewModel

<h3> Edit @Model.Name department</h3>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <label asp-for="Name">Name:</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"
          class="text-danger"></span>

    <label asp-for="Description">Descriptiom:</label>
    <input asp-for="Description" />
    <span asp-validation-for="Description"
          class="text-danger"></span>

    @foreach (var role in Model.JobRoles)
    {
        <div>
            <input
                   type="checkbox"
                   name="JobRoleIds"
                   value="@role.Id"
                   id="jobRole_@role.Id"
                   checked="@role.IsSelected" />

            <label class="form-check-label" for="jobRole_@role.Id">
                @role.Name
            </label>
        </div>
    }

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>