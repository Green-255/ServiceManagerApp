@model ServiceManagerApp.Models.Entities.Department
@using ServiceManagerApp.Models.Entities

@{
    ViewData["Title"] = Model.Name;
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none">
            &larr; Back to departments
        </a>

        <h1 class="h3 mt-3 mb-0">@Model.Name</h1>
    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        Edit department
    </a>
</div>

<!-- Department information -->
<section class="mb-4">
    <h2 class="h5">Description</h2>

    <p class="text-muted">
        @(string.IsNullOrWhiteSpace(Model.Description)
            ? "No description provided." : Model.Description)
    </p>
</section>

<!-- Job roles -->
<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Job roles</h2>

        <span class="text-muted">
            @Model.JobRoles.Count roles
        </span>
    </div>

    @if (!Model.JobRoles.Any())
    {
        <div class="border rounded p-4 text-center">
            <p class="text-muted mb-0">
                No job roles assigned to this department.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Role name</th>
                        <th scope="col" class="text-end">
                            Assigned workers
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var role in Model.JobRoles.OrderBy(r => r.Name))
                    {
                        <tr>
                            <td>@role.Name</td>
                            <td class="text-end">
                                @role.Workers.Count
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<!-- Destructive actions -->
@* <hr /> *@

<div class="d-flex justify-content-end mt-4">
    <form asp-action="Delete" asp-route-id="@Model.Id"  method="post"
          onsubmit="return confirm('Delete this department?');">

        <button type="submit" class="btn btn-outline-danger">
            Delete department
        </button>
    </form>
</div>

