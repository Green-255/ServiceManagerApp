@model ServiceManagerApp.Models.Entities.Department
@{
    ViewData["Title"] = Model.Name;
    var roleCount = Model.JobRoles?.Count ?? 0;
}

<div class="mx-auto" style="max-width: 960px;">
    <!-- Page heading -->
    <div class="mb-4">
        <a asp-action="Index" class="small text-decoration-none">&larr; Back to departments</a>
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mt-3">
            <div>
                <h1 class="h3 fw-semibold mb-1">@Model.Name</h1>
                <p class="text-muted mb-0">Department overview and assigned job roles</p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-shrink-0">Edit department</a>
        </div>
    </div>

    <!-- About the department -->
    <section class="card border shadow-sm mb-4" aria-labelledby="descriptionHeading">
        <div class="card-body p-4">
            <h2 id="descriptionHeading" class="h5 fw-semibold mb-3">About this department</h2>
            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted fst-italic mb-0">No description has been added yet.</p>
            }
            else
            {
                <p class="mb-0" style="white-space: pre-wrap;">@Model.Description</p>
            }
        </div>
    </section>

    <!-- Job roles -->
    <section class="card border shadow-sm mb-4" aria-labelledby="rolesHeading">
        <div class="card-header bg-white d-flex align-items-center justify-content-between gap-3 p-4">
            <div>
                <h2 id="rolesHeading" class="h5 fw-semibold mb-1">Assigned job roles</h2>
                <p class="small text-muted mb-0">Roles belonging to this department</p>
            </div>
            <span class="badge text-bg-light border text-secondary">@roleCount @(roleCount == 1 ? "role" : "roles")</span>
        </div>

        @if (roleCount == 0)
        {
            <div class="card-body text-center py-5">
                <p class="fw-semibold mb-1">No assigned job roles</p>
                <p class="small text-muted mb-3">Assign existing job roles to organize this department.</p>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">Manage job roles</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">Job role</th>
                            <th scope="col" class="text-end pe-4">Assigned workers</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model.JobRoles.OrderBy(r => r.Name))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@role.Name</td>
                                <td class="text-end pe-4">
                                    <span class="badge text-bg-light border text-secondary">@role.Workers.Count</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white text-end py-3 px-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="small text-decoration-none">Manage assigned job roles</a>
            </div>
        }
    </section>

    <!-- Destructive action -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 border-top pt-4 mb-4">
        <p class="text-muted small mb-0">Need to remove this department?</p>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal">
            Delete department
        </button>
    </div>
</div>

<div class="modal fade" id="deleteDepartmentModal" tabindex="-1"
     aria-labelledby="deleteDepartmentTitle" aria-describedby="deleteDepartmentText" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="deleteDepartmentTitle" class="modal-title fs-5">Delete department?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="deleteDepartmentText" class="mb-0">
                    Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="m-0">
                    <button type="submit" class="btn btn-danger">Delete department</button>
                </form>
            </div>
        </div>
    </div>
</div>
