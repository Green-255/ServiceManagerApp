@model ServiceManagerApp.Models.ViewModels.Departments.DepartmentCreateEditViewModel
@{
    ViewData["Title"] = "Create department";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">

        <!-- Page header -->
        <div class="mb-4">
            <h1 class="h3">Create department</h1>
            <p class="text-muted">
                Enter department information and assign job roles.
            </p>
        </div>


        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>


            <!-- Name -->
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name"
                       class="form-control"
                       placeholder="Department name" />
                <span asp-validation-for="Name"
                      class="text-danger"></span>
            </div>


            <!-- Description -->
            <div class="mb-4">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"
                          placeholder="Describe the department"></textarea>
                <span asp-validation-for="Description"
                      class="text-danger"></span>
            </div>


            <!-- Job roles -->
            <fieldset class="mb-4">
                <legend class="fs-6 fw-semibold">Job roles</legend>
                <p class="text-muted small">
                    Select the job roles belonging to this department.
                </p>

                <div class="border rounded p-3">
                    @if (!Model.JobRoles.Any())
                    {
                        <p class="text-muted mb-0">
                            No job roles available.
                        </p>
                    }
                    else
                    {
                        @foreach (var role in Model.JobRoles)
                        {
                            <div class="form-check mb-2">
                                <input type="checkbox"
                                       class="form-check-input"
                                       name="JobRoleIds"
                                       value="@role.Id"
                                       id="jobRole_@role.Id"
                                       checked="@role.IsSelected" />

                                <label class="form-check-label"
                                       for="jobRole_@role.Id">
                                    @role.Name
                                </label>
                            </div>
                        }
                    }
                </div>

                <span asp-validation-for="JobRoleIds"
                      class="text-danger"></span>
            </fieldset>


            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2 border-top pt-3">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    Create department
                </button>
            </div>

        </form>
    </div>
</div>
