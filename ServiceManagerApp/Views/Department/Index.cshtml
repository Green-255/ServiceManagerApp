@model IReadOnlyList<ServiceManagerApp.Models.Entities.Department>


<h2>Departments</h2>

<a asp-action="Create" class="btn btn-outline-primary">
    Add department
</a>

<table class="table">
    <thead>
        <tr>
            <td><strong>Name</strong></td>
            <td><strong>Description</strong></td>
            <td></td>
        </tr>
    </thead>

    <tbody>
        @foreach(var department in Model)
        {
            <tr>
                <td>@department.Name</td>
                <td>@department.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@department.Id" class="btn btn-primary">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
