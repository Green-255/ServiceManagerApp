@model IReadOnlyList<ServiceManagerApp.Models.Entities.Department>
@{
    ViewData["Title"] = "Departments";
}

<div class="mx-auto" style="max-width: 1100px;">
    <!-- Heading -->
    <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-semibold mb-1">Departments</h1>
            <p class="text-muted mb-0">Organize your teams and manage their job roles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary flex-shrink-0">+ Add department</a>
    </div>

    <div class="card border shadow-sm">
        <div class="card-body px-3 px-md-4 pt-4 pb-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="h5 fw-semibold mb-1">Department directory</h2>
                    <p class="small text-muted mb-0">Browse all departments or open one to manage its job roles.</p>
                </div>
                @if (Model.Any())
                {
                    <div class="d-flex align-items-center gap-2">
                        <label for="departmentSearch" class="visually-hidden">Search departments</label>
                        <input id="departmentSearch" type="search" class="form-control form-control-sm"
                               style="width: min(100%, 270px);" placeholder="Search departments…"
                               autocomplete="off" />
                        <span class="badge text-bg-light border text-secondary" id="departmentCount" aria-live="polite">
                            @Model.Count of @Model.Count
                        </span>
                    </div>
                }
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="card-body text-center py-5 border-top">
                <div class="fw-semibold mb-2">No departments yet</div>
                <p class="text-muted mb-3">Create a department to start organizing job roles.</p>
                <a asp-action="Create" class="btn btn-primary">Create department</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="departmentTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 ps-md-4" scope="col">Department</th>
                            <th scope="col">Description</th>
                            <th class="text-end pe-3 pe-md-4" scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var department in Model.OrderBy(d => d.Name))
                        {
                            <tr data-department-row>
                                <td class="ps-3 ps-md-4 fw-semibold">
                                    <a asp-action="Details" asp-route-id="@department.Id"
                                       class="text-decoration-none">@department.Name</a>
                                </td>
                                <td class="text-muted">
                                    @if (string.IsNullOrWhiteSpace(department.Description))
                                    {
                                        <span class="fst-italic">No description provided</span>
                                    }
                                    else
                                    {
                                        <div class="text-truncate" style="max-width: 450px;" title="@department.Description">
                                            @department.Description
                                        </div>
                                    }
                                </td>
                                <td class="text-end pe-3 pe-md-4">
                                    <a asp-action="Details" asp-route-id="@department.Id"
                                       class="btn btn-sm btn-outline-primary">View details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="departmentSearchEmpty" class="text-center py-5 border-top d-none" role="status">
                <p class="fw-semibold mb-1">No matching departments</p>
                <p class="text-muted small mb-0">Try a different name or description.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('departmentSearch');
            if (!input) return;
            const rows = Array.from(document.querySelectorAll('[data-department-row]'));
            const counter = document.getElementById('departmentCount');
            const empty = document.getElementById('departmentSearchEmpty');
            input.addEventListener('input', () => {
                const query = input.value.trim().toLocaleLowerCase();
                let shown = 0;
                for (const row of rows) {
                    const matches = row.textContent.toLocaleLowerCase().includes(query);
                    row.classList.toggle('d-none', !matches);
                    if (matches) shown++;
                }
                counter.textContent = `${shown} of ${rows.length}`;
                empty.classList.toggle('d-none', shown !== 0);
            });
        })();
    </script>
}
