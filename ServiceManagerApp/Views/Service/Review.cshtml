@using ServiceManagerApp.Models.Enums
@model ServiceManagerApp.Models.ViewModels.Services.Review.ServiceReviewViewModel

@{
    ViewData["Title"] = $"Review service {Model.ReferenceNumber}";
}

<div class="container py-4" style="max-width: 960px;">

    <!-- Page header -->
    <a asp-action="Index" class="d-inline-block small text-decoration-none mb-3">
        &larr; Back to services
    </a>

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-4">
        <div>
            <p class="text-muted small mb-1">SERVICE @Model.ReferenceNumber</p>
            <h1 class="h3 mb-1">Review service</h1>
            <p class="text-muted mb-0">Confirm the service details and team assignment before accepting.</p>
        </div>
        <span class="badge rounded-pill bg-warning text-dark mt-1">Needs review</span>
    </div>
    
    <!-- Edit fields -->
    <form asp-action="Review" method="post" asp-antiforgery="true">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ReferenceNumber" type="hidden" />
        <input asp-for="ServiceRequest.Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <!-- Description -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <!-- Description field -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Describe the service, instructions and relevant details"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>                
                <!-- Related service request -->
                <div class="border-top pt-3 mt-4">
                    <div class="text-muted small mb-2">
                        Related service request
                    </div>

                    @if (Model.ServiceRequest == null)
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="badge bg-light text-secondary border fw-normal">
                                Not linked
                            </span>

                            <span class="text-muted small">
                                This service was created independently.
                            </span>

                            @* <a asp-action="LinkRequest"
                               asp-route-id="@Model.Id"
                               class="btn btn-sm btn-outline-primary ms-sm-auto">
                                Select request
                            </a> *@
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="badge bg-success bg-opacity-10 text-opacity-75 text-success border border-success-subtle">
                                Linked
                            </span>

                            <a asp-controller="ServiceRequest"
                               asp-action="Details"
                               asp-route-id="@Model.ServiceRequest.Id"
                               class="text-decoration-none fw-semibold">
                                @Model.ServiceRequest.ReferenceNumber
                            </a>

                            <span class="text-muted small">
                                @Model.ServiceRequest.Title
                            </span>
                        </div>
                    }
                </div>

            </div>
        </div>

        <!-- Location, Date and Time -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-1">Schedule and location</h2>
                <p class="small text-muted mb-3">Check when and where this service should take place.</p>

                <div class="row g-3">
                    <div class="col-md-8 mb-3">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Main office, second floor" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DueAtUtc" class="form-label fw-semibold">Due date</label>
                        <input asp-for="DueAtUtc" asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local" class="form-control"/>
                        <span asp-validation-for="DueAtUtc" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <fieldset>
                            <legend class="form-label fw-semibold fs-6 mb-0">Estimated duration</legend>
                            <div class="row g-2">
                                <div class="col-6 d-flex justify-content-between align-items-center gap-1">
                                    <input asp-for="DurationHours" type="number" min="0" step="1" class="form-control" />
                                    <span asp-validation-for="DurationHours" class="text-danger small"></span>
                                    <label asp-for="DurationHours" class="form-label small text-muted">Hours</label>
                                </div>
                                <div class="col-6 d-flex justify-content-between align-items-center gap-1">
                                    <input asp-for="DurationMinutes" type="number" min="0" max="59" step="1" class="form-control" />
                                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                                    <label asp-for="DurationMinutes" class="form-label small text-muted">Minutes</label>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>

        <!-- Workers and skill level -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-1">Assign workers</h2>
                <p class="small text-muted mb-3">Select the workers who will carry out this service and choose skill level required for the service to complete.</p>

                <div class="col-md-3 mb-3">
                    <label asp-for="SkillLevel" class="form-label fw-semibold"></label>
                    <select asp-for="SkillLevel" asp-items="Html.GetEnumSelectList<SkillLevel>()"
                            class="form-select">
                        <option value="">No skill level</option>
                    </select>
                    <span asp-validation-for="SkillLevel" class="text-danger small"></span>
                </div>

                @if (Model.Workers.Any())
                {
                    <fieldset>
                        <legend class="visually-hidden">Workers to assign</legend>
                        <div class="row g-2">
                            @foreach (var worker in Model.Workers)
                            {
                                <div class="col-sm-6">
                                    <div class="border rounded p-3 h-100">
                                        <div class="form-check mb-0">
                                            <input type="checkbox" class="form-check-input"
                                                   name="WorkerIds" value="@worker.Id"
                                                   id="worker_@worker.Id" checked="@worker.IsSelected" />
                                            <label class="form-check-label" for="worker_@worker.Id">
                                                <span class="fw-semibold d-block">@worker.Name</span>
                                                <span class="small text-muted">@worker.SkillLevel</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </fieldset>
                }
                else
                {
                    <p class="text-muted mb-0">No workers are available to assign.</p>
                }
            </div>
        </div>

        <!-- Cost ans Priority -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-3 justify-content-between">
                    <!-- Cost -->
                    <div class="col-md-3">
                        <label asp-for="Cost"
                               class="form-label fw-semibold"></label>
                        <input asp-for="Cost"
                               type="number" min="0" step="any"
                               class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Cost"
                              class="text-danger small"></span>
                    </div>
                    <!-- Priority -->
                    <div class="col-md-3">
                        <label asp-for="Priority"
                               class="form-label fw-semibold">
                            Service priority
                        </label>
                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<ServicePriority>()"
                                class="form-select">
                        </select>
                        <span asp-validation-for="Priority"
                              class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex flex-wrap justify-content-between align-items-center ">
            <button type="button" class="btn btn-outline-danger"
                data-bs-toggle="modal" data-bs-target="#rejectServiceModal">
                Reject Service
            </button>

            <div class="gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Accept service</button>
            </div>
        </div>
    </form>
</div>

<div class="modal fade"
    id="rejectServiceModal"
    tabincex="-1"
    aria-labelledby="rejectServiceModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title"
                    id="rejectServiceModalLabel">
                        Reject this service?
                </h5>

                <button type="button" class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close">
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <p class="mb-0">
                    Are you sure you want to reject this service?
                </p>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary"
                    data-bs-dismiss="modal">
                        Cancel
                </button>

                <form asp-action="ReviewRejected" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Confirm rejection</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
