@model ServiceManagerApp.Models.ViewModels.Services.ServiceCreateViewModel

@{
    ViewData["Title"] = "Add service";
}

<div class="container py-4" style="max-width: 960px;">
    <a asp-action="Index" class="d-inline-block small text-decoration-none mb-3">
        &larr; Back to services
    </a>

    <div class="mb-4">
        <p class="text-muted small mb-1 text-uppercase">Service management</p>
        <h1 class="h3 mb-1">Add new service</h1>
        <p class="text-muted mb-0">Enter the schedule, location, and other details for this service.</p>
    </div>

    <form asp-action="Create" method="post" asp-antiforgery="true">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-1">Schedule</h2>
                @* <p class="small text-muted mb-4">Set the due date and expected duration.</p> *@

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="DueAtUtc" class="form-label fw-semibold">Due date</label>
                        <input asp-for="DueAtUtc" asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local" class="form-control" aria-describedby="dueHelp" />
                        <span asp-validation-for="DueAtUtc" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <fieldset>
                            <legend class="form-label fw-semibold fs-6">Estimated duration</legend>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label asp-for="DurationHours" class="form-label small text-muted">Hours</label>
                                    <input asp-for="DurationHours" type="number" min="0" step="1"
                                           class="form-control" placeholder="0" />
                                    <span asp-validation-for="DurationHours" class="text-danger small"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="DurationMinutes" class="form-label small text-muted">Minutes</label>
                                    <input asp-for="DurationMinutes" type="number" min="0" max="59" step="15"
                                           class="form-control" placeholder="0" aria-describedby="durationHelp" />
                                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                                </div>
                            </div>
                            @* <div id="durationHelp" class="form-text">Minutes in 15-minute increments (0, 15, 30, or 45).</div> *@
                        </fieldset>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-1">Service information</h2>
                <p class="small text-muted mb-4">Specify where the work will happen and its expected cost.</p>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Main office, second floor" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Cost" class="form-label fw-semibold"></label>
                        <input asp-for="Cost" type="number" min="0" step="any"
                               class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Cost" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h6 mb-3">Additional notes</h2>
                <label asp-for="Comments" class="form-label fw-semibold"></label>
                <textarea asp-for="Comments" class="form-control" rows="3"
                          placeholder="Add any instructions or other useful details"></textarea>
                <span asp-validation-for="Comments" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary px-4">Add service</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
