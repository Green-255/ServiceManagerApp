@model ServiceManagerApp.Models.ServiceCreateViewModel
@* @{
    ViewData["Title"] = "Services";
} *@

<h1> Add new service</h1>

<form asp-action="Create", method="post">
    <label asp-for="DueAtUtc"></label>
    <input asp-for="DueAtUtc" />
    <div asp-validation-summary="All"></div>
    
    <label asp-for="DurationHours"></label>
    <input asp-for="DurationHours"
        type="number" min="0"
        class="form-control" /> @* nz ka reiskia step="15" ir class="form-control*@
    <div asp-validation-summary="All"></div>

    <label asp-for="DurationMinutes"></label>
    <input asp-for="DurationMinutes"
        type="number" min="0" step="15"
        class="form-control" />
    <div asp-validation-summary="All"></div>

    <label asp-for="Location"></label>
    <input asp-for="Location" />
    <div asp-validation-summary="All"></div>

    <label asp-for="Comments"></label>
    <input asp-for="Comments" />
    <div asp-validation-summary="All"></div>

    <label asp-for="ServiceRequest"></label>
    <input asp-for="ServiceRequest" />
    <div asp-validation-summary="All"></div>

    <label asp-for="Cost"></label>
    <input asp-for="Cost" />
    <div asp-validation-summary="All"></div>

    <button type="submit">Add</button>
</form>