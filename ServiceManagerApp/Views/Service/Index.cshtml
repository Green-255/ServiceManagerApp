@model ServiceManagerApp.Models.ViewModels.Services.ServiceIndexViewModel

@{
    ViewData["Title"] = "Services";

    var servicesNeedingReview = Model.ServicesNeedingReview.ToList();
    var allServices = Model.AllServices.ToList();

    // Keep enum formatting and status styling consistent with the Details view.
    string ReadableLabel(string value) =>
        System.Text.RegularExpressions.Regex.Replace(value, @"(?<=[a-z])(?=[A-Z])", " ");

    string StatusBadgeClass(string status) => status switch
    {
        "Completed" => "bg-success bg-opacity-10 text-success",
        "InProgress" => "bg-primary bg-opacity-10 text-primary",
        "Draft" => "bg-secondary bg-opacity-10 text-secondary",
        "Scheduled" => "bg-info bg-opacity-10 text-dark",
        "Pending" or "NeedsReview" => "bg-warning bg-opacity-25 text-dark",
        "Cancelled" or "Canceled" => "bg-danger bg-opacity-25 text-danger",
        _ => "bg-secondary bg-opacity-10 text-secondary"
    };
}

<div class="container py-4" style="max-width: 1120px;">
    <!-- Page heading and primary action -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Services</h1>
            <p class="text-muted mb-0">Review pending work and manage your services.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary align-self-start align-self-sm-auto">
            + Add service
        </a>
    </div>

    <!-- Review queue -->
    <section class="mb-4" aria-labelledby="reviewHeading">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white px-4 py-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0" id="reviewHeading">Services needing review</h2>
                            <span class="badge rounded-pill bg-warning text-dark">@servicesNeedingReview.Count</span>
                        </div>
                        <p class="text-muted small mb-0">Items that need attention before moving forward.</p>
                    </div>
                </div>
            </div>

            @if (servicesNeedingReview.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <h3 class="h6 mb-2">Nothing to review</h3>
                    <p class="text-muted mb-0">All caught up. Services requiring review will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4 py-3">Reference number</th>
                                <th scope="col" class="py-3">Type</th>
                                <th scope="col" class="py-3">Status</th>
                                <th scope="col" class="py-3">Due date</th>
                                <th scope="col" class="text-end pe-4 py-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in servicesNeedingReview)
                            {
                                var status = service.Status.ToString();
                                <tr>
                                    <th scope="row" class="ps-4 py-3 fw-semibold">
                                        @service.ReferenceNumber
                                    </th>
                                    <td class="py-3">@ReadableLabel(service.ServiceRequestType.ToString())</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill fw-semibold @StatusBadgeClass(status)">
                                            @ReadableLabel(status)
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (service.DueAtUtc.HasValue)
                                        {
                                            <div>@service.DueAtUtc.Value.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">@service.DueAtUtc.Value.ToString("HH:mm") UTC</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <a asp-action="Review" asp-route-id="@service.Id"
                                           class="btn btn-sm btn-primary">Review</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <!-- Main service list -->
    <section aria-labelledby="serviceListHeading">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white px-4 py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="h5 mb-0" id="serviceListHeading">Service list</h2>
                            <span class="badge rounded-pill bg-secondary">@allServices.Count</span>
                        </div>
                        <p class="text-muted small mb-0">Browse the services currently in your list.</p>
                    </div>
                    @if (allServices.Count > 0)
                    {
                        <div class="w-100" style="max-width: 280px;">
                            <label for="serviceSearch" class="visually-hidden">Search services</label>
                            <input id="serviceSearch" type="search" class="form-control form-control-sm"
                                   placeholder="Search reference, type, status..." autocomplete="off" />
                        </div>
                    }
                </div>
            </div>

            @if (allServices.Count == 0)
            {
                <div class="card-body text-center py-5">
                    <h3 class="h6 mb-2">No services yet</h3>
                    <p class="text-muted mb-3">Create a service to get started.</p>
                    <a asp-action="Create" class="btn btn-outline-primary btn-sm">Add service</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="servicesTable">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="ps-4 py-3">Reference number</th>
                                <th scope="col" class="py-3">Type</th>
                                <th scope="col" class="py-3">Status</th>
                                <th scope="col" class="py-3">Due date</th>
                                <th scope="col" class="text-end pe-4 py-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var service in allServices)
                            {
                                var status = service.Status.ToString();
                                var searchTerms = $"{service.ReferenceNumber} {service.ServiceRequestType} {ReadableLabel(service.ServiceRequestType.ToString())} {status} {ReadableLabel(status)}";
                                <tr data-search="@searchTerms">
                                    <th scope="row" class="ps-4 py-3 fw-semibold">
                                        <a asp-action="Details" asp-route-id="@service.Id"
                                           class="text-decoration-none">@service.ReferenceNumber</a>
                                    </th>
                                    <td class="py-3">@ReadableLabel(service.ServiceRequestType.ToString())</td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill fw-semibold @StatusBadgeClass(status)">
                                            @ReadableLabel(status)
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        @if (service.DueAtUtc.HasValue)
                                        {
                                            <div>@service.DueAtUtc.Value.ToString("dd MMM yyyy")</div>
                                            <div class="small text-muted">@service.DueAtUtc.Value.ToString("HH:mm") UTC</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 py-3">
                                        <div class="d-inline-flex align-items-center gap-2">
                                            <a asp-action="Details" asp-route-id="@service.Id"
                                               class="btn btn-sm btn-outline-primary">Details</a>
                                            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none"
                                                    data-bs-toggle="modal" data-bs-target="#deleteServiceModal"
                                                    data-service-reference="@service.ReferenceNumber"
                                                    data-delete-url="@Url.Action("Delete", new { id = service.Id })">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="noServiceMatches" class="d-none text-center text-muted p-4" role="status">
                    No services match your search.
                </div>
                <div class="card-footer bg-white px-4 py-2">
                    <span class="small text-muted" id="serviceListCount">@allServices.Count services shown</span>
                </div>
            }
        </div>
    </section>
</div>

<!-- One shared confirmation modal; the clicked row supplies the reference and URL. -->
<div class="modal fade" id="deleteServiceModal" tabindex="-1"
     aria-labelledby="deleteServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="deleteServiceModalLabel">Delete service?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete service
                <strong id="deleteServiceReference"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post" asp-antiforgery="true"
                      id="deleteServiceForm" class="m-0">
                    <button type="submit" class="btn btn-danger">Delete service</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Searches only services already rendered in the main table.
            const searchInput = document.getElementById('serviceSearch');
            const serviceRows = document.querySelectorAll('#servicesTable tbody tr[data-search]');
            const emptyMessage = document.getElementById('noServiceMatches');
            const listCount = document.getElementById('serviceListCount');

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const query = searchInput.value.trim().toLowerCase();
                    let shown = 0;

                    serviceRows.forEach(function (row) {
                        const matches = (row.dataset.search || '').toLowerCase().includes(query);
                        row.classList.toggle('d-none', !matches);
                        if (matches) shown++;
                    });

                    emptyMessage.classList.toggle('d-none', shown !== 0);
                    listCount.textContent = shown + ' of ' + serviceRows.length + ' services shown';
                });
            }

            // Reuse a single confirmation dialog for every Delete button.
            const deleteModal = document.getElementById('deleteServiceModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                document.getElementById('deleteServiceReference').textContent =
                    button.getAttribute('data-service-reference') || '';
                document.getElementById('deleteServiceForm').action =
                    button.getAttribute('data-delete-url') || '';
            });
        });
    </script>
}
