@model IReadOnlyList<ServiceManagerApp.Models.Entities.Service>
@{
    ViewData["Title"] = "Services";
}

<h1> Services </h1>

<a asp-action="Create"> <strong> Add service </strong></a>

<table>
    <thead>
        <tr>
            <th> Name </th>
            <th> Description </th>
            <th> Type </th>
            <th> Cost </th>
            <th> Duration </th>
            <th/>
        </tr>
    </thead>
    <tbody>
        @foreach (var service in Model)
        {
            <tr>
                <td> @service.Name </td>
                <td> @service.Description </td>
                <td> @service.Type </td>
                <td> @service.Cost </td>
                <td> @service.Duration </td>
                <td> 
                    <a asp-action="Edit" asp-route-id="@service.Id">Edit</a> | 
                    <a asp-action="Delete" asp-route-id="@service.Id">Delete</a> 
                </td>
            </tr>
        }
    </tbody>
</table>
