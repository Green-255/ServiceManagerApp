@model ServiceManagerApp.Models.ViewModels.Services.ServiceIndexViewModel
@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>

<h2>Services needing review</h2>

@if (!Model.ServicesNeedingReview.Any())
{
    <p>No services currently need review.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Reference number</th>
                <th>Status</th>
                <th>Due At</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var service in Model.ServicesNeedingReview)
            {
                <tr>
                    <td>@service.ServiceRequestType</td>
                    <td>@service.ReferenceNumber</td>
                    <td>@service.Status</td>
                    <td>@service.DueAtUtc</td>  
                    <td>
                        <a asp-action="Edit" asp-route-id="@service.Id">Review</a>
                    </td>
                </tr>   
            }
        </tbody>
    </table>
}


<a asp-action="Create"> <strong> Add service </strong></a>

<h1> Services </h1>

@if (!Model.AllServices.Any())
{
    <p>No services found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Type</th>
                <th>Reference number</th>
                <th>Status</th>
                <th>Due At</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var service in Model.AllServices)
            {
                <tr>
                    <td>@service.ServiceRequestType</td>
                    <td>@service.ReferenceNumber</td>
                    <td>@service.Status</td>
                    <td>@service.DueAtUtc</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@service.Id">Details</a>
                        <form asp-action="Delete" asp-route-id="@service.Id" method="post">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}



