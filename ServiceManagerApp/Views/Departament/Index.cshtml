@model IReadOnlyList<ServiceManagerApp.Models.Entities.Departament>


<h2>Departaments</h2>

<a asp-action="Create">Add departament</a>

<table class="table">
    <thead>
        <tr>
            <td><strong>Name</strong></td>
            <td><strong>Description</strong></td>
        </tr>
    </thead>

    <tbody>
        @foreach(var departament in Model)
        {
            <tr>
                <td>@departament.Name</td>
                <td>@departament.Description</td>
                <td>
                    <a asp-action="Details" asp-route-id="@departament.Id">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
